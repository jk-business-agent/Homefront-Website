// Home Front Markets — database schema
// This file defines every table in the marketplace and how they relate.
// SQLite for local development; switch `provider` to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----- People who use the marketplace -----
// role is "BUYER", "SELLER", or "ADMIN".
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("BUYER")
  suspended    Boolean  @default(false) // admin can block this account
  // Two-factor auth (TOTP / authenticator app)
  totpSecret      String? // base32 secret; present once setup begins
  totpEnabled     Boolean @default(false)
  totpBackupCodes String? // JSON array of bcrypt-hashed single-use backup codes
  tokenVersion    Int     @default(0) // bump to invalidate all existing sessions ("log out everywhere")
  storeCreditCents Int    @default(0) // refunds (as store credit) + redeemed gift cards
  createdAt    DateTime @default(now())

  store         Store?         // set only when role = SELLER
  orders        Order[]        // orders this user has placed as a buyer
  addresses     Address[]
  favorites     Favorite[]     // products this user has liked
  reviews       Review[]       // reviews this user has written
  conversations Conversation[] @relation("BuyerConversations")
}

// ----- A seller's shop -----
model Store {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  bio         String? // short one-liner
  story       String? // longer "about the maker" write-up shown on product pages
  city        String?
  state       String? // e.g. "Tennessee" — where the maker is based
  employees   Int? // how many people they employ (for "keep America working")
  foundedYear Int?
  approved    Boolean @default(true) // admin can suspend a store (hides its products)
  featured    Boolean @default(false) // admin can feature a store on the homepage
  // Ship-FROM address used to generate shipping labels for this seller.
  shipFromLine1 String?
  shipFromCity  String?
  shipFromState String?
  shipFromZip   String?

  // Business legal & tax info (digital W-9). NOTE: taxId is sensitive — encrypt/tokenize before production.
  legalName     String?
  businessType  String? // Sole Proprietor | LLC | S-Corp | C-Corp | Partnership | Nonprofit
  taxIdType     String? // "EIN" | "SSN"
  taxId         String? // FEIN/EIN or SSN — masked in all responses (last 4 only)
  legalLine1    String?
  legalCity     String?
  legalState    String?
  legalZip      String?
  w9Name        String? // person who certified the W-9
  w9AcceptedAt  DateTime?
  onboardingComplete Boolean @default(false)

  createdAt   DateTime @default(now())

  owner         User           @relation(fields: [ownerId], references: [id])
  ownerId       String         @unique
  products      Product[]
  conversations Conversation[]
}

// ----- A product for sale (must be American made) -----
model Product {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  description        String
  priceCents         Int // stored in cents to avoid rounding bugs (4999 = $49.99)
  category           String
  emoji              String   @default("📦") // placeholder image until real photos
  imageUrls          String? // JSON array of image URLs (placeholders until real photos)
  madeInCity         String?
  madeInState        String?
  stockQty           Int      @default(100)
  weightOz           Int? // shipping weight in ounces
  shippingPriceCents Int      @default(0) // 0 = free shipping
  dimensions         String? // e.g. "12 x 8 x 3 in"
  sizes              String? // comma-separated for apparel, e.g. "S,M,L,XL"
  safetyInfo         String? // safety notes / restrictions
  rating             Float    @default(0)
  reviewCount        Int      @default(0)
  likeCount          Int      @default(0)
  active             Boolean  @default(true)
  featured           Boolean  @default(false) // legacy/general feature flag
  featuredHome       Boolean  @default(false) // feature in the homepage "Featured" row
  featuredCategory   Boolean  @default(false) // feature at the top of its category
  featuredNewsletter Boolean  @default(false) // feature on the newsletter page
  createdAt          DateTime @default(now())

  store   Store  @relation(fields: [storeId], references: [id])
  storeId String

  orderItems OrderItem[]
  favorites  Favorite[]
  reviews    Review[]
  views      ProductView[]
  variants   ProductVariant[]
  questions  Question[]

  @@index([category])
  @@index([storeId])
}

// ----- Per-size stock for an apparel product -----
model ProductVariant {
  id        String  @id @default(cuid())
  size      String
  stockQty  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@unique([productId, size])
  @@index([productId])
}

// ----- A single product page view (seller analytics + personalized recommendations) -----
model ProductView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  storeId   String // denormalized so a seller can query their own views fast
  userId    String? // who viewed it (when signed in) — powers "recommended for you"

  @@index([storeId])
  @@index([productId])
  @@index([userId])
}

// ----- A customer's saved shipping address -----
model Address {
  id        String  @id @default(cuid())
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id])
  userId    String

  @@index([userId])
}

// ----- An order placed by a buyer -----
// status: "PENDING" -> "PAID" -> "SHIPPED" -> "DELIVERED" (or "CANCELLED")
model Order {
  id            String   @id @default(cuid())
  status        String   @default("PENDING")
  totalCents    Int
  discountCents Int      @default(0)
  creditCents   Int      @default(0) // store credit applied to this order
  couponCode    String?
  shippingName    String
  shippingLine1   String
  shippingCity    String
  shippingState   String
  shippingZip     String
  shippingCents   Int      @default(0)
  shippingService String? // e.g. "USPS Priority"
  createdAt       DateTime @default(now())

  buyer   User   @relation(fields: [buyerId], references: [id])
  buyerId String

  items OrderItem[]

  @@index([buyerId])
}

// ----- A single line in an order -----
// Each item also tracks which store must ship it and whether it's shipped yet.
// fulfillmentStatus: "PENDING" -> "SHIPPED" -> "DELIVERED"
model OrderItem {
  id                String  @id @default(cuid())
  quantity          Int
  unitPriceCents    Int // price captured at time of order
  size              String? // chosen apparel size, if any
  fulfillmentStatus String  @default("PENDING")
  trackingCarrier   String? // "USPS" | "UPS" | "FedEx" | ...
  trackingNumber    String?
  labelUrl          String? // printable shipping label (PDF/PNG or our /label page)
  shipmentId        String? // carrier/EasyPost shipment id
  shippedAt         DateTime?

  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  storeId   String // denormalized so a seller can quickly find their items

  @@index([orderId])
  @@index([storeId])
}

// ----- A "like" / favorite on a product -----
model Favorite {
  id        String   @id @default(cuid())
  note      String? // buyer's private note on a saved item
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@unique([userId, productId])
  @@index([productId])
}

// ----- A customer review on a product (with optional photo/video) -----
model Review {
  id         String   @id @default(cuid())
  rating     Int // 1–5 stars
  title      String?
  body       String
  media      String? // JSON array of uploaded photo/video URLs
  authorName String
  hidden     Boolean  @default(false) // admin-moderated: hidden reviews don't show or count
  verified   Boolean  @default(false) // reviewer actually purchased this product
  createdAt  DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@index([productId])
}

// ----- A chat thread between a buyer and a store (platform/admin can also view & post) -----
model Conversation {
  id            String   @id @default(cuid())
  subject       String?
  orderId       String? // optional: tied to a specific order
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  buyer   User   @relation("BuyerConversations", fields: [buyerId], references: [id])
  buyerId String
  store   Store  @relation(fields: [storeId], references: [id])
  storeId String

  messages Message[]

  @@index([buyerId])
  @@index([storeId])
}

// ----- A single chat message -----
// senderRole: "BUYER" | "SELLER" | "ADMIN" (ADMIN = Homefront Markets support)
model Message {
  id             String   @id @default(cuid())
  body           String
  senderId       String
  senderRole     String
  senderName     String
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String

  @@index([conversationId])
}

// ----- Visitor → platform support chat ("Chat with us") -----
model SupportThread {
  id            String   @id @default(cuid())
  name          String
  email         String
  userId        String? // set if the visitor was signed in
  status        String   @default("OPEN") // OPEN | CLOSED
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages SupportMessage[]

  @@index([lastMessageAt])
}

model SupportMessage {
  id         String   @id @default(cuid())
  body       String
  fromRole   String // "USER" | "ADMIN"
  senderName String
  createdAt  DateTime @default(now())

  thread   SupportThread @relation(fields: [threadId], references: [id])
  threadId String

  @@index([threadId])
}

// ----- Discount / promo codes -----
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique // stored uppercase
  type            String    @default("PERCENT") // "PERCENT" | "FIXED"
  value           Int // percent (1-100) or fixed amount in cents
  active          Boolean   @default(true)
  minSubtotalCents Int      @default(0)
  maxUses         Int? // null = unlimited
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  storeId         String? // null = platform-wide (admin); set = seller coupon scoped to that store's items
  createdAt       DateTime  @default(now())

  @@index([storeId])
}

// ----- A customer question on a product (seller/admin can answer) -----
model Question {
  id         String    @id @default(cuid())
  body       String
  authorName String
  answer     String? // the seller's/admin's reply
  answeredBy String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  userId    String? // who asked (if signed in)

  @@index([productId])
}

// ----- "Email me when back in stock" requests -----
model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  email      String
  userId     String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, email])
  @@index([productId])
}

// ----- Digital gift cards -----
model GiftCard {
  id             String   @id @default(cuid())
  code           String   @unique // shown to recipient, redeemed for store credit
  initialCents   Int
  balanceCents   Int
  senderName     String?
  recipientEmail String?
  message        String?
  purchaserId    String?
  redeemedById   String?
  createdAt      DateTime @default(now())

  @@index([redeemedById])
}

// ----- A buyer's return/refund request for an order item -----
model ReturnRequest {
  id          String    @id @default(cuid())
  orderId     String
  orderItemId String
  userId      String // buyer who requested
  storeId     String // seller whose item it is
  productName String
  quantity    Int       @default(1)
  reason      String
  status      String    @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | REFUNDED
  refundCents Int       @default(0)
  restock     Boolean   @default(true)
  adminNote   String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([userId])
  @@index([storeId])
}

// ----- Per-user security events (sign-ins, password/2FA changes) -----
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // "login" | "password_change" | "2fa_enabled" | "2fa_disabled" | "logout_all"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----- Admin audit log (who did what) -----
model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String // e.g. "seller.approve", "product.hide", "user.suspend"
  detail    String? // human-readable detail
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ----- Site-wide customization (single row, admin-editable) -----
model SiteSettings {
  id            String   @id @default("main")
  announcement  String   @default("Every product verified American Made — supporting U.S. workers, farms & factories")
  // Announcement bar controls
  announcementEnabled Boolean   @default(true)
  announcementLink    String? // optional URL the banner links to
  announcementStart   DateTime? // optional schedule window (null = always)
  announcementEnd     DateTime?
  heroHeadline  String   @default("Shop American. Support the home front.")
  heroSubtext   String   @default("A marketplace of products made by U.S. hands — from work boots to hand tools, all from verified American makers.")
  heroCtaText   String   @default("Start Shopping")
  accentColor   String   @default("#d99a3f")
  primaryColor  String   @default("#16243a") // deep navy — headers, buttons
  headingFont   String   @default("oswald")  // font key (see lib/theme)
  bodyFont      String   @default("cabin")
  footerTagline String   @default("The marketplace for American-made goods. Built to keep U.S. makers thriving and dollars on the home front.")
  popupEnabled  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// ----- Storefront categories (admin-managed) -----
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ----- Newsletter email subscribers -----
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("popup") // where they signed up: "popup", "page", "footer"
  createdAt DateTime @default(now())
}

// ----- SMS marketing opt-ins (TCPA: store express consent + proof) -----
model SmsSubscriber {
  id          String   @id @default(cuid())
  phone       String   @unique // E.164, e.g. +13125551234
  consent     Boolean  @default(true) // express written consent given
  consentText String? // the exact disclosure shown at opt-in (proof)
  source      String   @default("landing") // "landing" | "checkout" | ...
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

// ----- Newsletter stories / articles -----
model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String // short teaser shown in lists & the popup
  body       String // plain-text fallback (auto-derived from blocks)
  blocks     String? // JSON array of content blocks: text / heading / image (the rich layout)
  coverEmoji String   @default("📰")
  coverImage String? // optional uploaded cover image (overrides the emoji)
  author     String   @default("Homefront Markets")
  category   String   @default("Maker Stories")
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([published])
}

// ----- CMS: an editable storefront page (admin-built from widgets) -----
// `key` is the URL identity: "home" renders at "/", others render at "/p/<key>".
model Page {
  id              String    @id @default(cuid())
  key             String    @unique // url slug / identity, e.g. "home", "our-promise"
  title           String
  published       Boolean   @default(true)
  system          Boolean   @default(false) // built-in pages can't be deleted (home/about/vendors)
  showInNav       Boolean   @default(false) // show a link in the top navigation
  navLabel        String? // label for the nav link (defaults to title)
  navOrder        Int       @default(0)
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sections Section[]

  @@index([published])
}

// ----- CMS: one widget instance placed on a page -----
// `type` selects the widget (hero, featuredProducts, newsletter, …);
// `config` is a JSON blob with that widget's settings.
model Section {
  id        String   @id @default(cuid())
  type      String
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  config    String   @default("{}") // JSON string of widget settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String

  @@index([pageId])
}
